        <mxCell id="D1" value="15张表：sys_user · elderly_profile · escort_profile · hospital · escort_order · order_status_log · settlement · evaluation · medical_record · medical_document · ai_task · ai_generated_content · sys_notification · ai_chat_session · ai_chat_message&lt;br&gt;（43个二级索引：UNIQUE 7 ＋ 普通 36，不含主键）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="780" height="100" as="geometry"/></mxCell>
