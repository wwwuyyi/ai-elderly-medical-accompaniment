        <mxCell id="B1" value="安全层：LoginInterceptor ＋ @RequireRole（AOP） ＋ UserContext（ThreadLocal）｜统一返回：Result 统一响应体 ＋ GlobalExceptionHandler 全局异常处理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="780" height="45" as="geometry"/></mxCell>
        <mxCell id="B2" value="模块层（12 Controller / 67 API）：auth · user · elderly · escort · order · record · ai（含AI对话） · admin · notify · file · hospital" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="780" height="50" as="geometry"/></mxCell>
        <mxCell id="B3" value="AI子模块：AiHttpClient（OkHttp双实例）→ 外部OCR/LLM&lt;br&gt;超时 · 重试 · 熔断 · 异步 · 幂等 · 校验 · 审计 · 免责声明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="B4" value="脱敏子模块：@SensitiveField ＋ Jackson序列化器&lt;br&gt;AES加密存储 ＋ DesensitizeUtil日志脱敏" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="460" y="440" width="380" height="60" as="geometry"/></mxCell>
