        <mxCell id="F1" value="家属端（12页）&lt;br&gt;适老化设计&lt;br&gt;AI健康咨询" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="185" height="100" as="geometry"/></mxCell>
