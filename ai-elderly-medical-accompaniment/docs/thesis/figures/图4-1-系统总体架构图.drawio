      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="L1" value="前端展示层（Vue 3.4 + Vite 5 + Element Plus）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#E8F5E9;strokeColor=#82B366;" vertex="1" parent="1">
