<mxfile host="app.diagrams.net" agent="thesis-review" version="24.0.0">
  <diagram id="desens" name="图4-5 脱敏序列化流程图">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane1" value="通用序列化流程" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="900" as="geometry"/></mxCell>
        <mxCell id="lane2" value="ADMIN（管理员）" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="240" height="900" as="geometry"/></mxCell>
        <mxCell id="lane3" value="ESCORT（陪诊师）" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="240" height="900" as="geometry"/></mxCell>
        <mxCell id="lane4" value="FAMILY（家属）" style="swimlane;html=1;startSize=30;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="240" height="900" as="geometry"/></mxCell>
        <mxCell id="s1" value="Controller返回&lt;br&gt;Result（MedicalRecordVO）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p1" value="Jackson序列化VO&lt;br&gt;遍历字段，发现@SensitiveField注解" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p2" value="SensitiveFieldSerializer.serialize()&lt;br&gt;读取UserContext.getUserRole()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="d0" value="角色？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="a1" value="按脱敏规则返回：&lt;br&gt;诊断 → “[诊断结论已脱敏]”&lt;br&gt;姓名/电话/住址 → 对应规则脱敏&lt;br&gt;（审核详情idCard解密例外，见4.5.3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="540" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="e0" value="窗口期判断：存在状态为&lt;br&gt;ACCEPTED/IN_SERVICE&lt;br&gt;的关联escort_order？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="520" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="是（窗口期内）：&lt;br&gt;电话 → 全量&lt;br&gt;姓名/诊断/住址 → 脱敏&lt;br&gt;（诊断=“[诊断结论已脱敏]”）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="690" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="e2" value="否（窗口期外）：&lt;br&gt;电话 → 138****1111&lt;br&gt;姓名/诊断/住址 → 脱敏&lt;br&gt;（诊断=“[诊断结论已脱敏]”）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="810" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="f1" value="全量返回原始值&lt;br&gt;（身份证号经服务端解密&lt;br&gt;明文返回，仅限归属本人档案）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="540" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="pEnd" value="JSON序列化完成 → 返回给前端" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="860" width="180" height="60" as="geometry"/></mxCell>
