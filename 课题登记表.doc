                </w:rPr>
                <w:t><![CDATA[实现业务逻辑与数据持久化，完成陪诊下单预约、订单状态管理、派单接单、费用结算、服务评价、医疗单据识别建档、就医电子档案管理、陪诊师资质审核、病历隐私脱敏、多角色账号鉴权等功能；前端采用]]></w:t>
              </w:r>              
              <w:r>
                <w:rPr>
                  <w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:cs="Times New Roman" w:hint="fareast"/>
