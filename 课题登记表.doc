                <w:rPr>
                  <w:rFonts w:hint="fareast"/>
                  <wx:font wx:val="宋体"/>
                  <w:sz w:val="24"/>
                </w:rPr>
                <w:t><![CDATA[为家属、陪诊师、系统管理员三类使用者实现差异化交互界面，并针对老年用户群体做好适老化设计（界面简洁、字体醒目、操作流程精简）。需重点解决两个关键问题：一是外部]]></w:t>
              </w:r>              
              <w:r>
                <w:rPr>
                  <w:rFonts w:ascii="Times New Roman" w:h-ansi="Times New Roman" w:cs="Times New Roman" w:hint="fareast"/>
                  <w:sz w:val="21"/>
                  <w:sz-cs w:val="21"/>
                  <w:lang w:val="EN-US" w:fareast="ZH-CN"/>
                </w:rPr>
                <w:t><![CDATA[OCR]]></w:t>
